# ==========================================
# MuMuAINovel 配置文件示例
# ==========================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env

# ==========================================
# 应用配置
# ==========================================
APP_NAME=MuMuAINovel
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# ==========================================
# SQLite 数据库配置（嵌入式，无需独立服务器）
DATABASE_URL=sqlite+aiosqlite:///./data/mumuai.db
DATABASE_PATH=./data/mumuai.db

# SQLite 连接池配置（SQLite 为单写者模式，仅需少量连接）
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=True
DATABASE_POOL_USE_LIFO=True

# 会话监控配置
DATABASE_SESSION_MAX_ACTIVE=50  # 活跃会话警告阈值
DATABASE_SESSION_LEAK_THRESHOLD=100  # 会话泄漏严重告警阈值

# 数据库监控配置
DATABASE_ENABLE_SLOW_QUERY_LOG=True  # 启用慢查询日志
DATABASE_SLOW_QUERY_THRESHOLD=1.0  # 慢查询阈值（秒）
DATABASE_ENABLE_METRICS=True  # 启用性能指标收集

# ==========================================
# 代理配置（可选）
# ==========================================
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
# NO_PROXY=localhost,127.0.0.1

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ==========================================
# CORS 配置
# ==========================================
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ==========================================
# AI 服务配置（至少配置一个）
# ==========================================

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic 配置（可选）
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认 AI 配置
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# ==========================================
# 出站地址守卫（防 SSRF）
# ==========================================
# 普通用户自填的 AI 接口地址、MCP 服务器只能连公网；管理员不受限（桌面版、单机自用登录的就是管理员）。
# 上面的 OPENAI / ANTHROPIC / GEMINI_BASE_URL 自动放行。局域网多人自用、确需让普通用户连内网服务时：
# OUTBOUND_ALLOWED_HOSTS=["192.168.1.10:11434","ollama.lan"]
# 整体关掉（只在所有账号都可信时）：
# OUTBOUND_GUARD_ENABLED=false

# ==========================================
# Linux.do 登录 / 邮箱注册登录
# ==========================================
# 不走环境变量：登录后在「管理台 → 用户管理 → 登录方式设置」里填写
# Linux.do Client ID / Secret / 回调地址 与 SMTP 参数，保存即时生效

# ==========================================
# 本地账户登录配置
# ==========================================
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=your_secure_password_here
LOCAL_AUTH_DISPLAY_NAME=本地管理员

# ==========================================
# 会话配置
# ==========================================
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30

# ==========================================
# 部署配置示例
# ==========================================

# Docker 生产环境配置:
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DEBUG=false
# LOG_LEVEL=WARNING

# 外网访问配置:
# CORS_ORIGINS=["https://your-domain.com"]
# APP_PORT=8000

# 中转 API 配置示例:
# OPENAI_BASE_URL=https://api.new-api.com/v1
# DEFAULT_MODEL=gpt-4o-mini